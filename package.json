{
  "name": "safe-markdown2html",
  "private": false,
  "type": "module",
  "version": "1.0.18",
  "description": "Convert Markdown to sanitized HTML with DOMPurify. Safe by default — prevents XSS and malformed markup.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/index.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test:dist": "node scripts/smoke-dist.mjs",
    "prepublishOnly": "npm run build",
    "preversion": "npm run build",
    "postversion": "git push --follow-tags",
    "release": "npm publish --access public",
    "release:patch": "npm version patch && npm publish --access public",
    "release:minor": "npm version minor && npm publish --access public",
    "release:major": "npm version major && npm publish --access public",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\""
  },
  "author": "kimhongyeon",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.1"
  },
  "peerDependencies": {
    "jsdom": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kimhongyeon/safe-markdown2html"
  },
  "bugs": {
    "url": "https://github.com/kimhongyeon/safe-markdown2html/issues"
  },
  "homepage": "https://github.com/kimhongyeon/safe-markdown2html",
  "keywords": [
    "markdown",
    "html",
    "sanitize",
    "xss",
    "dompurify",
    "marked",
    "converter",
    "safe",
    "security",
    "browser",
    "node",
    "isomorphic"
  ],
  "engines": {
    "node": ">=22.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "minimatch": "^11.0.2",
    "glob": "^14.0.3"
  }
}
